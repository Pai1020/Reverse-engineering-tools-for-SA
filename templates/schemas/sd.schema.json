{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SD.json",
  "description": "Structured sidecar for SD.md, written by the sd skill alongside the markdown doc, mirroring §1-§9.",
  "type": "object",
  "required": ["function_name", "generated_at", "entry_point"],
  "properties": {
    "function_name": { "type": "string" },
    "module": { "type": "string" },
    "feature": { "type": "string" },
    "page": { "type": "string" },
    "service_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "entry_point": { "type": "string" },
    "program_type": { "type": "string", "enum": ["ui", "service", "batch", "rest", "ws"] },
    "design_overview": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "dependency_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" }, "component": { "type": "string" },
              "usage": { "type": "string" }, "criticality": { "type": "string", "enum": ["high", "medium", "low"] },
              "source_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "entry_point_annotation": { "type": "string" },
        "component_responsibilities": {
          "type": "array",
          "items": { "type": "object", "properties": { "component": { "type": "string" }, "responsibility": { "type": "string" } } }
        }
      }
    },
    "method_decomposition": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "method": { "type": "string" }, "io_spec": { "type": "string" }, "navigation_pattern": { "type": "string" } }
      }
    },
    "data_flow": {
      "type": "object",
      "properties": {
        "cross_layer_summary": { "type": "string" },
        "state_transitions": { "type": "array", "items": { "type": "string" } },
        "value_conversions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transaction_strategy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": { "type": "string" }, "propagation": { "type": "string" },
          "manager": { "type": "string" }, "consistency_risk": { "type": ["string", "null"], "description": "Non-null flags a ⚠️ cross-TM risk" }
        }
      }
    },
    "integration_points": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "contract_boundary": { "type": "string" } } }
    },
    "exception_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "path": { "type": "string" }, "handling": { "type": "string" }, "rollback_behavior": { "type": "string" } }
      }
    },
    "design_decisions": {
      "type": "array",
      "items": { "type": "object", "properties": { "decision": { "type": "string" }, "why": { "type": "string" } } }
    },
    "target_architecture_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": { "type": "string" }, "target_layer": { "type": "string" },
          "api_boundary": { "type": "boolean", "description": "True if this call needs a defined contract (feeds api-contract applicability)" }
        }
      }
    },
    "pending_review": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "speculation": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "impact": { "type": "string" }
        }
      }
    }
  }
}
